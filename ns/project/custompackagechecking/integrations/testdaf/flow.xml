<?xml version="1.0" encoding="UTF-8"?>

<FLOW VERSION="3.2" CLEANUP="false">
  <COMMENT></COMMENT>

  <!-- nodes -->

<SEQUENCE NAME="IF" EXIT-ON="FAILURE" CONDITION="((%/a%==%/b%))" FORM="IF">

  <!-- nodes -->

<INVOKE NAME="Math" SERVICE="pub.math:addInts">

  <!-- nodes -->

<MAP MODE="INPUT">
  <COMMENT></COMMENT>

  <!-- nodes -->

<MAPCOPY FROM="/a;1;0" TO="/num1;1;0">
</MAPCOPY>

<MAPCOPY FROM="/b;1;0" TO="/num2;1;0">
</MAPCOPY>
</MAP>

<MAP MODE="OUTPUT">
  <COMMENT></COMMENT>
</MAP>
</INVOKE>
</SEQUENCE>

<SEQUENCE NAME="ELSE" EXIT-ON="FAILURE" CONDITION="" FORM="ELSE">

  <!-- nodes -->

<INVOKE NAME="Flow" SERVICE="pub.flow:debugLog">

  <!-- nodes -->

<MAP MODE="INPUT">
  <COMMENT></COMMENT>

  <!-- nodes -->

<MAPSET NAME="Setter" OVERWRITE="true" VARIABLES="false" GLOBALVARIABLES="false" FIELD="/message;1;0">
  <DATA ENCODING="XMLValues" I18N="true">

<Values version="2.0">
  <value name="xml">not equal</value>
</Values>
</DATA>
</MAPSET>
</MAP>

<MAP MODE="OUTPUT">
  <COMMENT></COMMENT>
</MAP>
</INVOKE>
</SEQUENCE>
</FLOW>
